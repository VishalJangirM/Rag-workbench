# ── RAGBench Backend Environment Variables ────────────────────────────────────
# Copy this file to .env in the backend/ folder and fill in your values.

# LLM configuration (OpenAI or compatible API)
# Leave blank to run in retrieval-only mode (no AI-generated answers)
OPENAI_API_KEY=

# Optional: use an OpenAI-compatible endpoint (e.g. Ollama, Azure, Together AI)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Model to use for answer generation
DEFAULT_LLM=gpt-4o-mini

# Sentence-Transformers embedding model (downloaded automatically on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage paths (relative to backend/ by default)
# UPLOAD_DIR=./data/uploads
# INDEX_DIR=./data/indexes
# DB_PATH=./data/ragbench.db

# Upload limits
MAX_UPLOAD_MB=50

# Chunking defaults
CHUNK_SIZE=500
CHUNK_OVERLAP=64

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173
